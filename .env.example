# Solo para un build EN LÍNEA en local (python -m pipeline build). El build offline,
# docker compose y los tests no leen ninguna variable. .env nunca se sube a GitHub.
# En GitHub Actions estos valores van en Settings -> Secrets and variables (docs/despliegue.md).

# Obligatorias en modo en línea (sin ellas el pipeline no arranca)
SKILLSCOPE_GITHUB_TOKEN=
SKILLSCOPE_SITE_URL=

# Opcionales
SKILLSCOPE_REPOSITORY=
SKILLSCOPE_MAX_SECONDS=
SKILLSCOPE_STACKEXCHANGE_KEY=
SKILLSCOPE_BLUESKY_HANDLE=
SKILLSCOPE_BLUESKY_APP_PASSWORD=
SKILLSCOPE_YOUTUBE_API_KEY=
SKILLSCOPE_REDDIT_CLIENT_ID=
SKILLSCOPE_REDDIT_CLIENT_SECRET=
SKILLSCOPE_REDDIT_USER_AGENT=
